def beep_args(tones):
    args = []
    if not tones:
        return args
    t0 = tones[0][0]
    ms = lambda t: int(round((t - t0) * 1000))
    for i, (a, b, p, *_) in enumerate(tones):
        length = ms(b) - ms(a)
        if length <= 0:
            continue
        if args:
            args.append('-n')
        args += ['-f', str(int(round(midi_to_hz(p)))), '-l', str(length)]
        if i + 1 < len(tones):
            delay = ms(tones[i + 1][0]) - ms(b)
            if delay > 0:
                args += ['-D', str(delay)]
    return args


def write_wav(path, tones, rate=22050, amp=6000):
    buf = array('h')
    if not tones:
        tones = []
    t0 = tones[0][0] if tones else 0.0
    pos = 0
    for a, b, p, *_ in tones:
        s, e = int((a - t0) * rate), int((b - t0) * rate)
        if s > pos:
            buf.extend([0] * (s - pos))
        n = max(0, e - max(s, pos))
        f2 = 2 * midi_to_hz(p) / rate
        buf.extend([amp if int(i * f2) & 1 == 0 else -amp for i in range(n)])
        pos = max(pos, e)
    buf.extend([0] * (rate // 4))
    if sys.byteorder == 'big':
        buf.byteswap()
    with wave.open(path, 'wb') as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(buf.tobytes())


def print_info(voices, song_len, fmt, file=sys.stderr):
    print(f'format {fmt}, {len(voices)} voices, {song_len:.1f}s', file=file)
    print(f'{"#":>3} {"role":<7} {"score":>6} {"notes":>6} {"pitch":>5} {"poly":>5} {"cover":>5}  voice', file=file)
    for v in voices:
        if v.drums:
            role = 'drums'
        elif v.double_of is not None:
            role = f'=#{v.double_of}'
        elif v.muted:
            role = 'muted'
        else:
            role = 'MELODY' if v.melody else 'backgr'
        s = v.stats
        if s:
            print(f'{v.id:>3} {role:<7} {v.score:6.2f} {len(v.notes):6d} {note_name(round(s["pitch"])):>5} '
                  f'{s["poly"]:5.2f} {s["coverage"]:5.2f}  {v.label()}', file=file)
        else:
            print(f'{v.id:>3} {role:<7} {"":>6} {len(v.notes):6d} {"":>5} {"":>5} {"":>5}  {v.label()}', file=file)


def parse_ids(s):
    out = set()
    for part in (s or '').replace(' ', '').split(','):
        if not part:
            continue
        if '-' in part:
            a, b = part.split('-', 1)
            out.update(range(int(a), int(b) + 1))
        else:
            out.add(int(part))
    return out


def seconds_arg(text):
    """Non-negative seconds; accepts a decimal comma too (2,5 == 2.5)."""
    try:
        value = float(text.strip().replace(',', '.'))
    except ValueError:
        raise argparse.ArgumentTypeError(f'not a number of seconds: {text!r}')
    if value < 0 or math.isnan(value) or math.isinf(value):
        raise argparse.ArgumentTypeError(f'must be a non-negative number of seconds: {text!r}')
    return value


def main():
    ap = argparse.ArgumentParser(
        description='Convert a multi-channel MIDI file into a melody-first single-voice beep sequence.',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='examples:\n'
               '  midibeep song.mid --play            # analyse and play on the PC speaker\n'
               '  midibeep song.mid --info            # show how voices were rated\n'
               '  midibeep song.mid --melody 2,5 -p   # force voices #2 and #5 as melody\n'
               '  midibeep song.mid --fill arp -p     # chords in melody gaps as arpeggios\n'
               '  midibeep song.mid --wav test.wav    # preview without the speaker\n'
               '  midibeep song.mid -o song.sh        # save a runnable beep script\n'
               '  midibeep song.mid -S 12.5 -p        # skip the first 12.5 s of the song\n')
    ap.add_argument('midi')
    ap.add_argument('-p', '--play', action='store_true', help='play through `beep`')
    ap.add_argument('-o', '--output', metavar='FILE', help='write a runnable shell script with the beep command')
    ap.add_argument('-w', '--wav', metavar='FILE', help='render a square-wave WAV preview')
    ap.add_argument('-i', '--info', action='store_true', help='print the voice analysis')
    ap.add_argument('-d', '--dump', action='store_true', help='print the resulting note sequence')
    ap.add_argument('-q', '--quiet', action='store_true', help='do not print the beep command')
    ap.add_argument('-m', '--melody', metavar='IDS', help='voice numbers (from --info) to treat as melody, e.g. 1,3-4')
    ap.add_argument('-x', '--mute', metavar='IDS', help='voice numbers to ignore completely')
    ap.add_argument('-f', '--fill', choices=['notes', 'arp', 'none'], default='notes',
                    help='what plays when the melody rests: best background note (default), '
                         'arpeggiated chord, or silence')
    ap.add_argument('--arp-ms', type=float, default=35, help='arpeggio step in ms (default 35)')
    ap.add_argument('--margin', type=float, default=0.2,
                    help='voices scoring within this of the best are melody (default 0.2)')
    ap.add_argument('-s', '--speed', type=float, default=1.0, help='tempo multiplier, 2 = twice as fast')
    ap.add_argument('-t', '--transpose', type=int, default=0, help='semitones')
    ap.add_argument('--lowest', type=int, default=45,
                    help='fold notes below this MIDI pitch up by octaves (default 45 = A2, 110 Hz)')
    ap.add_argument('--highest', type=int, default=100,
                    help='fold notes above this MIDI pitch down (default 100 = E7)')
    ap.add_argument('--min-note', type=float, default=30, help='shortest tone kept, ms (default 30)')
    ap.add_argument('--gap', type=float, default=15, help='silence between repeated pitches, ms (default 15)')
    ap.add_argument('--sustain', type=float, metavar='MS',
                    help='how long a held note keeps full priority before background may '
                         'take over (default 500; large value = never)')
    ap.add_argument('--keep-tremolo', action='store_true', help='do not merge tremolo/repeated 32nds into long notes')
    ap.add_argument('--keep-doubles', action='store_true', help='do not drop voices that duplicate/echo another voice')
    ap.add_argument('-S', '--skip', '--start', dest='skip', type=seconds_arg, default=0, metavar='SEC',
                    help='skip this many seconds from the start of the MIDI file, fractions '
                         'allowed (2.5 or 2,5); counted in song time, before --speed')
    ap.add_argument('--length', type=seconds_arg, default=0, metavar='SEC',
                    help='only this many seconds after the skip point')
    args = ap.parse_args()
    if args.highest - args.lowest < 11:
        ap.error('--highest must be at least 11 semitones above --lowest')
    if args.speed <= 0:
        ap.error('--speed must be positive')

    try:
        fmt, voices = extract_notes(args.midi)
    except (OSError, ValueError, struct.error) as e:
        sys.exit(f'midibeep: {args.midi}: {e}')
    if not voices:
        sys.exit('midibeep: no notes found')

    song_len = max(n.end for v in voices for n in v.notes)
    if not args.keep_tremolo:
        for v in voices:
            merge_tremolo(v)
    analyze_voices(voices, song_len)
    known = {v.id for v in voices}
    melody_ids, mute_ids = parse_ids(args.melody), parse_ids(args.mute)
    for i in (melody_ids | mute_ids) - known:
        sys.exit(f'midibeep: no voice #{i} (see --info)')
    if not args.keep_doubles:
        for dup, orig in find_doubles(voices, skip=mute_ids).items():
            if dup not in melody_ids:
                voices[dup].double_of = orig
                mute_ids.add(dup)
    assign_roles(voices, melody_ids, mute_ids, args.margin)
    local_weights(voices, song_len, melody_ids)
    if args.sustain is not None:
        Params.hold = args.sustain / 1000
    if args.info:
        print_info(voices, song_len, fmt)

    if args.skip >= song_len:
        sys.exit(f'midibeep: --skip {args.skip:g}s is past the end of the song ({song_len:.1f}s)')
    if args.skip or args.length:
        lo_t = args.skip
        hi_t = args.skip + args.length if args.length else float('inf')
        for v in voices:
            v.notes = [n for n in v.notes if n.end > lo_t and n.start < hi_t]
            for n in v.notes:
                n.start, n.end = max(n.start, lo_t), min(n.end, hi_t)

    frags = project(voices, args.fill, Params)
    frags = cleanup(frags, args.min_note / 1000)
    tones = to_tones(frags, voices, args.fill, args.arp_ms, args.gap,
                     args.transpose, args.lowest, args.highest, args.speed)
    if not tones:
        sys.exit('midibeep: nothing to play')

    if args.dump:
        for a, b, p, is_fill, vid in tones:
            print(f'{a:8.3f} {int((b - a) * 1000):5d}ms {note_name(p):>4}  #{vid:<3}{" fill" if is_fill else ""}',
                  file=sys.stderr)

    bargs = beep_args(tones)
    cmd = 'beep ' + ' '.join(shlex.quote(a) for a in bargs)
    if args.output:
        with open(args.output, 'w') as f:
            f.write('#!/bin/sh\n# generated by midibeep from ' + os.path.basename(args.midi) + '\n')
            f.write('exec ' + cmd + '\n')
        if os.path.isfile(args.output):
            os.chmod(args.output, 0o755)
    if args.wav:
        write_wav(args.wav, tones)
    if not (args.quiet or args.play or args.output or args.wav or args.info or args.dump):
        print(cmd)
    if args.play:
        total = tones[-1][1] - tones[0][0]
        print(f'playing {len(tones)} tones, {total:.0f}s ... (Ctrl+C to stop)', file=sys.stderr)
        try:
            sys.exit(subprocess.call(['beep'] + bargs))
        except KeyboardInterrupt:
            sys.exit(130)
        except FileNotFoundError:
            sys.exit('midibeep: `beep` not found')


if __name__ == '__main__':
    main()
